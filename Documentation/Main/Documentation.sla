        <PAGEOBJECT XPOS="160" YPOS="140" OwnPage="0" ItemID="183738384" PTYPE="4" WIDTH="419.2" HEIGHT="240" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L419.2 0 L419.2 240 L0 240 L0 0 Z" copath="M0 0 L419.2 0 L419.2 240 L0 240 L0 0 Z" gXpos="160" gYpos="140" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONTSIZE="14" CH="Example - "/>
                <ITEXT FONT="Arial Bold" FONTSIZE="14" CH="Math.smp(&quot;add&quot;, 1, 1)"/>
                <ITEXT FONT="Arial Regular" FONTSIZE="14" CH=";"/>
                <para/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="Rules and Protocols - "/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="1)"/>
                <ITEXT CH=" Starts with the module import name; "/>
                <ITEXT FONT="Arial Bold" CH="&quot;Math&quot;"/>
                <ITEXT CH=" or desired."/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="2)"/>
                <ITEXT CH=" Second function selection is the "/>
                <ITEXT FONT="Arial Bold" CH="MODULE"/>
                <ITEXT CH=" selection; "/>
                <ITEXT FONT="Arial Bold" CH="&quot;smp&quot;"/>
                <ITEXT CH=" stands for &quot;simple&quot; which describes the calculation type;"/>
                <para/>
                <ITEXT CH="simple is the function to access "/>
                <ITEXT FONT="Arial Bold" CH="core math functions."/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="3) In brackets-(), First-string "/>
                <ITEXT FONT="Arial Regular" CH="is the"/>
                <ITEXT FONT="Arial Bold" CH=" Operation;"/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="4)"/>
                <ITEXT CH=" After First-string, everything is a input, usage of the input by the operation is described by the documentation."/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="5)"/>
                <ITEXT CH=" For aditional options/operations in one command, there can be used a special mode, "/>
                <ITEXT FONT="Arial Bold" CH="after the MODULE selection;"/>
                <ITEXT CH=" ex-math.smp.extra(&quot;round-down&quot;, 1.5) or "/>
                <ITEXT FONT="Arial Bold" FONTSIZE="11" CH="math.smp.extra(&quot;exponents&quot;, 2, 5, 2) = 2^(5+2) which is not allowed in normal core exponent function."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.5" YPOS="397" OwnPage="0" ItemID="183547024" PTYPE="4" WIDTH="283" HEIGHT="21.6666666666667" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L283 0 L283 21.6667 L0 21.6667 L0 0 Z" copath="M0 0 L283 0 L283 21.6667 L0 21.6667 L0 0 Z" gXpos="136.5" gYpos="397" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
