        <PAGEOBJECT XPOS="160" YPOS="439" OwnPage="0" ItemID="183552384" PTYPE="4" WIDTH="420.333333333333" HEIGHT="380" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L420.333 0 L420.333 380 L0 380 L0 0 Z" copath="M0 0 L420.333 0 L420.333 380 L0 380 L0 0 Z" gXpos="160" gYpos="439" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONTSIZE="14" CH="Example - "/>
                <ITEXT FONT="Arial Bold" FONTSIZE="14" CH="Math.smp(&quot;add&quot;, 1, 1)"/>
                <ITEXT FONT="Arial Regular" FONTSIZE="14" CH=";"/>
                <para/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;Math&quot;"/>
                <ITEXT CH=" - "/>
                <ITEXT FONT="Arial Bold Italic" CH="Module import"/>
                <ITEXT CH=" by the user. ex- import math-tools as math;"/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;.&quot;"/>
                <ITEXT CH=" - Define the "/>
                <ITEXT FONT="Arial Bold Italic" CH="end of module name"/>
                <ITEXT CH=" import and start of next operation to python."/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;smp&quot;"/>
                <ITEXT CH=" - "/>
                <ITEXT FONT="Arial Bold Italic" CH="Core function selection"/>
                <ITEXT CH=" of the tool according to the task. ex - smp for simple/core functions. cmplx for not simple answers rather entire blocks/equations;"/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;()&quot;"/>
                <ITEXT CH=" - Defining the "/>
                <ITEXT FONT="Arial Bold Italic" CH="use of the function"/>
                <ITEXT CH=" in python;"/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;add&quot;"/>
                <ITEXT CH=" - string inputting/"/>
                <ITEXT FONT="Arial Bold Italic" CH="operation desired to do on inputs;"/>
                <para/>
                <ITEXT FONT="Arial Bold" CH="&quot;, 1, 1&quot;"/>
                <ITEXT CH=" - "/>
                <ITEXT FONT="Arial Bold Italic" CH="Inputs"/>
                <ITEXT CH=", some operations allow many, some only limited-info in documentation;"/>
                <para/>
                <para/>
                <ITEXT FONT="Arial Black" FONTSIZE="15" CH="Information-"/>
                <para/>
                <para/>
                <ITEXT CH="1) More functions can be added even after smp for desired result or even post processing."/>
                <para/>
                <ITEXT CH="2) Documentation is requested to be used when using the solver."/>
                <para/>
                <ITEXT CH="3) These Commands/operations RETURN DATA!, they never print any data directly so thse can be used as inputs directly."/>
                <para/>
                <ITEXT CH="4) All Core functionality is available in this documentaiton, including all the other functions/operations."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
